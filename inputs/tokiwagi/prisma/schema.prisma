generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int       @id @default(autoincrement())
  password                 String?
  name                     String?
  firstName                String?   @map("first_name")
  lastName                 String?   @map("last_name")
  firstNameFurigana        String?   @map("first_name_furigana")
  lastNameFurigana         String?   @map("last_name_furigana")
  email                    String?   @unique
  emailVerified            DateTime? @map("email_verified")
  image                    String?
  role                     Role      @default(User)
  token                    String?   @unique
  phone                    String?
  postCode                 String?   @map("post_code")
  province                 String?   @map("province")
  address                  String?   @map("address")
  birthday                 DateTime? @db.Date
  gender                   Boolean?  @default(true)
  allowedNewsletter        Boolean   @default(true) @map("allowed_newsletter")
  isBlacklist              Boolean   @default(false) @map("is_blacklist")
  loginAttempts            Int?      @map("login_attempts")
  locked                   Boolean?  @default(false)
  firstCheckedOutBookingId Int?      @map("first_checked_out_booking_id")
  lineUserId               String?   @map("line_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deleted   Boolean?  @default(false)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  AdminTenant        AdminTenant?
  Account            Account[]
  Booking            Booking[]
  UserTenantFavorite UserTenantFavorite[]
  AdminActivityLog   AdminActivityLog[]

  @@index([name, phone])
  @@index([role, deleted, createdAt])
  @@index([email])
  @@index([token])
  @@index([lineUserId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Tenant {
  code               String               @id @unique
  name               String
  imageUrl           String?              @map("image_url")
  siteUrl            String?              @map("site_url")
  postCode           String?              @map("post_code")
  province           String?              @map("province")
  address            String
  guide              String?
  phone              String?              @map("phone")
  openedAt           DateTime?            @map("opened_at") @db.Time
  closedAt           DateTime?            @map("closed_at") @db.Time
  servedUtil         DateTime?            @map("served_util") @db.Time
  active             Boolean              @default(true)
  note               String?              @map("note")
  gmoId              Int?                 @map("gmo_id")
  GMOSetting         GMOSetting?          @relation(fields: [gmoId], references: [id])
  allowedVersion     TenantVersion        @default(v2) @map("allowed_version")
  smaregiStoreId     String?              @map("smaregi_store_id") @db.VarChar(100)
  smaregiContractId  String?              @map("smaregi_contract_id") @db.VarChar(100)
  smaregiTerminalId  String?              @map("smaregi_terminal_id") @db.VarChar(100)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deleted            Boolean?             @default(false)
  Booking            Booking[]
  AdminTenant        AdminTenant?
  UserTenantFavorite UserTenantFavorite[]
  Ticket             Ticket[]
  Staff              Staff[]

  @@index([deleted])
  @@index([active])
  @@map("tenants")
}

model AdminTenant {
  userId     Int     @unique @map("user_id")
  User       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantCode String  @unique @map("tenant_code")
  Tenant     Tenant? @relation(fields: [tenantCode], references: [code], onDelete: Cascade)

  @@id([userId, tenantCode])
  @@map("admins_tenants")
}

model Staff {
  id                String  @id
  password          String
  name              String?
  firstName         String? @map("first_name")
  lastName          String? @map("last_name")
  firstNameFurigana String? @map("first_name_furigana")
  lastNameFurigana  String? @map("last_name_furigana")
  role              Role

  tenantCode String  @map("tenant_code")
  Tenant     Tenant? @relation(fields: [tenantCode], references: [code], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  AdminActivityLog AdminActivityLog[]

  @@map("staffs")
}

model AdminActivityLog {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  User         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId      String?   @map("staff_id")
  Staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  activityType String    @map("activity_type")
  details      String?
  reference    String?
  createdAt    DateTime? @default(now()) @map("created_at")

  @@map("admin_activity_logs")
}

model UserTenantFavorite {
  userId     Int       @map("user_id")
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantCode String    @map("tenant_code")
  Tenant     Tenant    @relation(fields: [tenantCode], references: [code], onDelete: Cascade)
  createdAt  DateTime? @default(now()) @map("created_at")

  @@id([userId, tenantCode])
  @@map("users_tenants_favorites")
}

model Ticket {
  id         Int     @id @default(autoincrement())
  name       String
  tenantCode String? @map("tenant_code")
  Tenant     Tenant? @relation(fields: [tenantCode], references: [code], onDelete: Cascade)
  videoUrl   String? @map("video_url")

  visibility       Boolean     @default(true)
  paymentType      PaymentType @map("payment_type")
  type             TicketType  @map("ticket_type")
  canBookInAdvance Boolean     @map("can_book_in_advance")

  childAgeLimitFrom Int @map("child_age_limit_from")
  childAgeLimitTo   Int @map("child_age_limit_to")
  maxChildPerAdult  Int @map("max_child_per_adult")

  adultTicketCode Int? @map("adult_ticket_code")
  childTicketCode Int? @map("child_ticket_code")

  displayOrder Int? @map("display_order")

  isPromotion Boolean @default(false) @map("is_promotion")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  masterTicketId Int?    @map("master_ticket_id")
  groupId        String? @map("group_id")

  TicketDetail          TicketDetail?
  Booking               Booking[]
  TicketBookingSchedule TicketBookingSchedule[]
  TicketDiscountSetting TicketDiscountSetting?

  @@index([tenantCode])
  @@index([type])
  @@index([visibility])
  @@index([masterTicketId])
  @@map("tickets")
}

model TicketDetail {
  id       Int    @id @default(autoincrement())
  ticketId Int    @unique @map("ticket_id")
  Ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  totalDaysInUseFromStart Int?      @map("total_days_in_use_from_start")
  startSaleAt             DateTime? @map("start_sale_at") @db.Date
  endSaleAt               DateTime? @map("end_sale_at") @db.Date

  adultPrice                      Decimal? @map("adult_price")
  adultSmaregiQRCodeUrl           String?  @map("adult_smaregi_qrcode_url") @db.VarChar(255)
  adultObicCode                   String?  @map("adult_obic_code") @db.VarChar(255)
  adultSmaregiQRCodeUrl1stBooking String?  @map("adult_smaregi_qrcode_url_1st_booking") @db.VarChar(255)
  adultObicCode1stBooking         String?  @map("adult_obic_code_1st_booking") @db.VarChar(255)
  childPrice                      Decimal? @map("child_price")
  childSmaregiQRCodeUrl           String?  @map("child_smaregi_qrcode_url") @db.VarChar(255)
  childObicCode                   String?  @map("child_obic_code") @db.VarChar(255)
  childSmaregiQRCodeUrl1stBooking String?  @map("child_smaregi_qrcode_url_1st_booking") @db.VarChar(255)
  childObicCode1stBooking         String?  @map("child_obic_code_1st_booking") @db.VarChar(255)

  enableDiscount                Boolean? @map("enable_discount")
  discountAdultThreshold        Decimal? @map("discount_adult_threshold")
  discountAdultAmount           Decimal? @map("discount_adult_amount")
  discountAdultSmaregiQRCodeUrl String?  @map("discount_adult_smaregi_qrcode_url") @db.VarChar(255)
  discountAdultObicCode         String?  @map("discount_adult_obic_code") @db.VarChar(255)

  discountChildThreshold        Decimal? @map("discount_child_threshold")
  discountChildAmount           Decimal? @map("discount_child_amount")
  discountChildSmaregiQRCodeUrl String?  @map("discount_child_smaregi_qrcode_url") @db.VarChar(255)
  discountChildObicCode         String?  @map("discount_child_obic_code") @db.VarChar(255)

  requiredAgreement Boolean? @map("required_agreement")

  limitTimes Int? @map("limit_times")
  extraTimes Int? @map("extra_times")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ticket_details")
}

model TicketDiscountSetting {
  id       Int    @id @default(autoincrement())
  ticketId Int    @unique @map("ticket_id")
  Ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  setting                Json? @map("setting")
  hourlyExtraTimeSetting Json? @map("hourly_extra_time_setting")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ticketId])
  @@map("ticket_discount_settings")
}

model TicketBookingSchedule {
  id       Int    @id @default(autoincrement())
  ticketId Int    @map("ticket_id")
  Ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  startSaleAt DateTime  @map("start_sale_at")
  endSaleAt   DateTime? @map("end_sale_at")
  dateFrom    DateTime  @map("date_from") @db.Date
  dateTo      DateTime? @map("date_to") @db.Date
  timeFrom    DateTime? @map("time_from") @db.Time
  timeTo      DateTime? @map("time_to") @db.Time

  canBookingBeforeInDay        Int       @map("can_booking_before_in_day")
  canBookingFrom               DateTime? @map("can_booking_from") @db.Time
  canBookingUtil               DateTime  @map("can_booking_util") @db.Time
  canCancelOrChangeBeforeInDay Int       @map("can_cancel_or_change_before_in_day")
  canCancelOrChangeUtil        DateTime  @map("can_cancel_or_change_util") @db.Time

  enableRemind      Boolean   @map("enable_remind")
  remindBeforeInDay Int?      @map("remind_before_in_day")
  remindAt          DateTime? @map("remind_at") @db.Time

  enableExpirationRemind      Boolean?  @map("enable_expiration_remind")
  expirationRemindBeforeInDay Int?      @map("expiration_remind_before_in_day")
  expirationRemindAt          DateTime? @map("expiration_remind_at") @db.Time

  maxBookingTimes                      Int?     @map("max_booking_times")
  maxBookingPeople                     Int?     @map("max_booking_people")
  maxBookingPeopleAccumulative         Boolean? @map("max_booking_people_accumulative")
  invisibleWhenReachedMaxBookingPeople Boolean? @map("invisible_when_reached_max_booking_people")

  baseAdultPeriod           Decimal?   @map("base_adult_period")
  baseAdultPeriodUnit       PriceUnit? @map("base_adult_period_unit")
  baseAdultPeriodPrice      Decimal?   @map("base_adult_period_price")
  baseAdultSmaregiQRCodeUrl String?    @map("base_adult_smaregi_qrcode_url") @db.VarChar(255)
  baseAdultObicCode         String?    @map("base_adult_obic_code") @db.VarChar(255)

  baseChildPeriod           Decimal?   @map("base_child_period")
  baseChildPeriodUnit       PriceUnit? @map("base_child_period_unit")
  baseChildPeriodPrice      Decimal?   @map("base_child_period_price")
  baseChildSmaregiQRCodeUrl String?    @map("base_child_smaregi_qrcode_url") @db.VarChar(255)
  baseChildObicCode         String?    @map("base_child_obic_code") @db.VarChar(255)

  extendedAdultPeriod           Decimal?   @map("extended_adult_period")
  extendedAdultPeriodUnit       PriceUnit? @map("extended_adult_period_unit")
  extendedAdultPeriodPrice      Decimal?   @map("extended_adult_period_price")
  extendedAdultSmaregiQRCodeUrl String?    @map("extended_adult_smaregi_qrcode_url") @db.VarChar(255)
  extendedAdultObicCode         String?    @map("extended_adult_obic_code") @db.VarChar(255)

  extendedChildPeriod           Decimal?   @map("extended_child_period")
  extendedChildPeriodUnit       PriceUnit? @map("extended_child_period_unit")
  extendedChildPeriodPrice      Decimal?   @map("extended_child_period_price")
  extendedChildSmaregiQRCodeUrl String?    @map("extended_child_smaregi_qrcode_url") @db.VarChar(255)
  extendedChildObicCode         String?    @map("extended_child_obic_code") @db.VarChar(255)

  deleted Boolean? @default(false)

  isScheduleInFutureDeleted Boolean? @default(false) @map("is_schedule_in_future_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  Booking Booking[]

  @@index([ticketId, deleted, dateTo])
  @@index([ticketId])
  @@index([dateTo])
  @@index([deleted])
  @@map("ticket_booking_schedules")
}

model Booking {
  id         Int    @id @default(autoincrement())
  tenantCode String @map("tenant_code")
  Tenant     Tenant @relation(fields: [tenantCode], references: [code], onDelete: Cascade)
  ticketId   Int    @map("ticket_id")
  Ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     Int?   @map("user_id")
  User       User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  adultQuantity Int      @map("adult_quantity")
  adultPrice    Decimal? @map("adult_price")
  childQuantity Int      @map("child_quantity")
  childPrice    Decimal? @map("child_price")

  totalAmount    Decimal? @map("total_amount")
  webTotalAmount Decimal? @map("web_total_amount")
  posTotalAmount Decimal? @map("pos_total_amount")
  smaregiQRCodes Json?    @map("smaregi_qr_codes")
  coupons        Json?    @map("coupons")

  status           BookingStatus @default(Successful)
  paymentStatus    PaymentStatus @default(Pending) @map("payment_status")
  isSmaregiScanned Boolean       @default(false) @map("is_smaregi_scanned")

  GMOTransactionId String? @map("GMO_transaction_id")

  smaregiConfirmedTransactionHeadId      String?   @map("smaregi_confirmed_transaction_head_id")
  smaregiConfirmedTransactionAt          DateTime? @map("smaregi_confirmed_transaction_at")
  smaregiConfirmedTransactionCancelledAt DateTime? @map("smaregi_confirmed_transaction_cancelled_at")

  barCode  String  @map("bar_code")
  subEmail String? @map("sub_email")

  date DateTime? @map("date") @db.Date

  firstCheckedInAt DateTime? @map("first_checked_in_at")
  checkedInAt      DateTime? @map("checked_in_at")
  checkedOutAt     DateTime? @map("checked_out_at")
  firstCheckoutAt  DateTime? @map("first_checkout_at")
  tempCheckoutAt   DateTime? @map("temp_checkout_at")

  parentBookingId Int? @map("parent_booking_id")

  waitingOrder         Int?      @map("waiting_order")
  waitingAt            DateTime? @map("waiting_at")
  callingAt            DateTime? @map("calling_at")
  remindedAt           DateTime? @map("reminded_at")
  expirationRemindedAt DateTime? @map("expiration_reminded_at")
  cancelledAt          DateTime? @map("cancelled_at")
  requestedReCheckInAt DateTime? @map("requested_re_check_in_at")
  reCheckInCount       Int?      @default(0) @map("re_check_in_count")

  partialCheckedOutAdultQuantity Int?      @map("partial_checked_out_adult_quantity")
  partialCheckedOutChildQuantity Int?      @map("partial_checked_out_child_quantity")
  partialCheckedOutAt            DateTime? @map("partial_checked_out_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  BookingChildAgeInfo BookingChildAgeInfo[]
  PartialCheckout     PartialCheckout[]
  BookingObicCode     BookingObicCode[]

  ticketBookingScheduleId Int?                   @map("ticket_booking_schedule_id")
  TicketBookingSchedule   TicketBookingSchedule? @relation(fields: [ticketBookingScheduleId], references: [id])

  stayDuration     Int? @map("stay_duration")
  lastStayDuration Int? @map("last_stay_duration")

  @@index([barCode, createdAt])
  @@index([tenantCode, status, date])
  @@index([userId, status])
  @@index([ticketId])
  @@index([parentBookingId, status])
  @@index([createdAt])
  @@index([date])
  @@index([status])
  @@index([paymentStatus, GMOTransactionId, createdAt])
  @@index([paymentStatus, GMOTransactionId, userId])
  @@map("bookings")
}

model BookingChildAgeInfo {
  id        Int     @id @default(autoincrement())
  bookingId Int     @map("booking_id")
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  childAgeInMonth Int @map("child_age_in_month")

  PartialCheckout PartialCheckout[]

  @@index([bookingId])
  @@map("booking_child_age_infos")
}

model PartialCheckout {
  id           Int      @id @default(autoincrement())
  bookingId    Int      @map("booking_id")
  Booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedOutAt DateTime @map("checked_out_at")
  isAdult      Boolean  @map("is_adult")
  quantity     Int      @map("quantity")

  bookingChildAgeInfoId Int?                 @map("booking_child_age_info_id")
  BookingChildAgeInfo   BookingChildAgeInfo? @relation(fields: [bookingChildAgeInfoId], references: [id], onDelete: Cascade)

  deleted Boolean? @default(false)

  @@index([bookingId])
  @@index([deleted])
  @@map("partial_checkouts")
}

model AppSetting {
  settingKey String   @id @map("setting_key")
  name       String
  value      String
  dataType   DataType @map("data_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model EmailSetting {
  emailKey String   @id @map("email_key")
  name     String
  title    String
  content  String
  active   Boolean? @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

model News {
  id      Int      @id @default(autoincrement())
  date    DateTime @map("date") @db.Date
  title   String
  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model Disclaimer {
  id    Int    @id @default(autoincrement())
  title String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  DisclaimerOption DisclaimerOption[]

  @@map("disclaimers")
}

model DisclaimerOption {
  id           Int        @id @default(autoincrement())
  disclaimerId Int        @map("disclaimer_id")
  Disclaimer   Disclaimer @relation(fields: [disclaimerId], references: [id], onDelete: Cascade)
  content      String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("disclaimer_options")
}

model GMOSetting {
  id       Int    @id @default(autoincrement())
  name     String
  shopId   String @unique @map("shop_id")
  shopPass String @map("shop_pass")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  Tenant Tenant[]

  @@map("gmo_settings")
}

model SecurityQuestion {
  id       Int     @id @default(autoincrement())
  question String
  answer   String?

  @@map("security_questions")
}

model SseNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, id])
  @@index([createdAt])
  @@map("sse_notifications")
}

enum Role {
  User
  Admin
  SuperAdmin
  Staff
}

enum BookingStatus {
  Successful
  Cancelled
  Waiting
  CheckedIn
  CheckedOut
  Calling
  SystemCancelled
}

enum PaymentStatus {
  Error
  Pending
  Completed
  Refunded
}

enum TenantVersion {
  v0
  v1
  v2
}

enum PriceUnit {
  Minute
  Hour
  Day
}

enum PaymentType {
  Online
  Offline
}

enum TicketType {
  Hourly
  Daily
  Monthly
  MasterMonthly
  HourlyTimesLimit
  DailyTimesLimit
}

enum DataType {
  Text
  Number
  RichText
}

model BookingObicCode {
  id        Int     @id @default(autoincrement())
  bookingId Int     @map("booking_id")
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  kind     ObicCodeKind
  audience ObicAudience
  obicCode String       @map("obic_code") @db.VarChar(255)

  sourceField     ObicSourceField @map("source_field")
  sourceTierIndex Int?            @map("source_tier_index")

  amount    Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)
  lineIndex Int     @map("line_index")
  isPending Boolean @default(false) @map("is_pending")

  revision   Int      @default(1)
  computedAt DateTime @default(now()) @map("computed_at")
  deleted    Boolean  @default(false) @map("deleted")

  @@index([bookingId])
  @@index([bookingId, isPending, sourceField, sourceTierIndex])
  @@index([bookingId, obicCode, quantity])
  @@index([bookingId, deleted])
  @@map("booking_obic_codes")
}

enum ObicCodeKind {
  Base
  ExtendedPeriod
  Discount
  HourlyExtraTimeDiscount
}

enum ObicAudience {
  Adult
  Child
}

enum ObicSourceField {
  TD_adultObicCode
  TD_adultObicCode1stBooking
  TD_childObicCode
  TD_childObicCode1stBooking
  TD_discountAdultObicCode
  TD_discountChildObicCode
  TBS_baseAdultObicCode
  TBS_baseChildObicCode
  TBS_extendedAdultObicCode
  TBS_extendedChildObicCode
  TDS_hourlyExtraTime_adultObicCode
  TDS_hourlyExtraTime_childObicCode
  TDS_discountTier_adultObicCode
  TDS_discountTier_childObicCode
}

model SmaregiTemporaryTransaction {
  id                          Int                    @id @default(autoincrement())
  bookingBarCode              String                 @map("bar_code")
  temporaryTransactionHeadId  String?                @map("temporary_transaction_head_id")
  temporaryTransactionBarcode String?                @map("temporary_transaction_barcode")
  preRegistrationName         String?                @map("pre_registration_name")
  storeId                     String?                @map("store_id")
  terminalId                  String?                @map("terminal_id")
  total                       Decimal?               @db.Decimal(10, 2)
  status                      SmaregiTemporaryStatus @default(Normal)
  checkedInAt                 DateTime?              @map("checked_in_at")
  settledTransactionHeadId    String?                @map("settled_transaction_head_id")
  syncError                   String?                @map("sync_error")
  syncedAt                    DateTime?              @map("synced_at")
  deletedAt                   DateTime?              @map("deleted_at")
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")

  @@unique([temporaryTransactionBarcode])
  @@index([status])
  @@map("smaregi_temporary_transactions")
}

model SmaregiTransaction {
  id                 Int      @id @default(autoincrement())
  transactionHeadId  String   @unique @map("transaction_head_id")
  contractId         String?  @map("contract_id")
  storeId            String?  @map("store_id")
  action             String
  total              Decimal?
  rawPayload         Json     @map("raw_payload")
  affectedBookingIds Json?    @map("affected_booking_ids")
  source             String   @default("Webhook")
  processedAt        DateTime @default(now()) @map("processed_at")

  @@index([storeId])
  @@map("smaregi_transactions")
}

// Mirrors the Smaregi 仮販売 status (0: Normal, 1: Completed, 2: Cancelled).
enum SmaregiTemporaryStatus {
  Normal
  Completed
  Cancelled
}
