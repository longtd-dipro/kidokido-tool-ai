NODE_ENV=development
ENV=dev
DEBUG=true

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret

DATABASE_URL=postgresql://postgres:1234567890@localhost:5432/postgres

LOG_LEVEL=info
LOG_FOLDER_PATH=./logs

EXTERNAL_URL=http://localhost:3000

EMAIL_SERVICE=gmail
EMAIL_FROM=support@test.com
EMAIL_USER=test@gmail.com
EMAIL_PASSWORD=your_password

LINE_CLIENT_ID=your_line_client_id
LINE_CLIENT_SECRET=your_line_client_secret

GMO_API_URL=https://kt01.mul-pay.jp
GMO_SHOP_PASS=your_gmo_shop_pass
GMO_SITE_ID=your_gmo_site_id
GMO_SITE_PASS=your_gmo_site_password
NEXT_PUBLIC_GMO_SHOP_ID=your_gmo_shop_id
NEXT_PUBLIC_TOKEN_URL=GMO_TOKEN_URL

POS_API_KEY=API_KEY

ENABLE_CRON_JOB=true

STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=tokiwagi-uploads
AWS_S3_COMMON_BUCKET=tokiwagi-common
AWS_REGION=region
AWS_CLOUDWATCH_LOG_GROUP=log-group
ENABLE_CLOUDWATCH_LOG=true

# Number of days in advance that online one-day booking is allowed (default: 30)
NEXT_PUBLIC_ONLINE_BOOKING_ADVANCE_DAYS=7

BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=123123

# Smaregi Platform API (POS charge sync). Set SMAREGI_ENABLE=true with real credentials to turn on.
SMAREGI_API_BASE_URL="https://api.smaregi.dev/{contractId}/pos"
SMAREGI_ID_BASE_URL="https://id.smaregi.dev"
SMAREGI_CLIENT_ID="your_smaregi_client_id"
SMAREGI_CLIENT_SECRET="your_smaregi_client_secret"
SMAREGI_SCOPES="pos.stores:read pos.stores:write pos.products:read pos.products:write pos.transactions:read pos.transactions:write"
