def COLOR_MAP = ['SUCCESS': 'good', 'FAILURE': 'danger', 'UNSTABLE': 'danger', 'ABORTED': 'danger']

@NonCPS
def getChangeString() {
    MAX_MSG_LEN = 100
    def changeString = ""
    echo "Gathering SCM changes"
    def changeLogSets = currentBuild.rawBuild.changeSets
    for (int i = 0; i < changeLogSets.size(); i++) {
        def entries = changeLogSets[i].items
        for (int j = 0; j < entries.length; j++) {
            def entry = entries[j]
            truncated_msg = entry.msg.take(MAX_MSG_LEN)
            changeString += " - ${truncated_msg} [${entry.author}]\n"
        }
    }
    if (!changeString) {
        changeString = " - No new changes"
    }
    return changeString
}

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY_URL = 'https://docker-reg.dipro-tech.com'
        DOCKER_REGISTRY_USERNAME = credentials('DOCKER_REGISTRY_USERNAME')
        DOCKER_REGISTRY_PW = credentials('DOCKER_REGISTRY_PW')

        SERVER_USERNAME = credentials('SERVER_USERNAME')
        SERVER_URL_TEST = credentials('SERVER_URL_TEST')
        SERVER_URL_PRODUCTION = credentials('SERVER_URL_PRODUCTION')
        SERVER_SSH_KEY_FILE = credentials('SERVER_SSH_KEY_FILE')
        SERVER_PROJECT_DIR = credentials('SERVER_PROJECT_DIR')

        ENV_TEST = credentials('ENV_TEST')
        ENV_PRODUCTION = credentials('ENV_PRODUCTION')

        DISABLE_BUILD_STEP = credentials('DISABLE_BUILD_STEP')

        AWS_ACCESS_KEY_ID = credentials('TOKIWAGI_AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('TOKIWAGI_AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION = 'ap-northeast-1'
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        // Select environment
        // -- Test Environment
        stage('Use Test Env') {
            when {
                branch 'test'
            }
            steps {
                script {
                    env.TAG = 'test'
                    env.ENV_FILE = "${env.ENV_TEST}"
                    env.SERVER_URL = "${env.SERVER_URL_TEST}"
                }

                echo "BUILD_ENV: test"
                echo "TAG: $TAG"
            }
        }
        // -- Production Environment
        stage('Use Production Env') {
            when {
                branch 'master'
            }
            steps {
                script {
                    env.TAG = 'production'
                    env.ENV_FILE = "${env.ENV_PRODUCTION}"
                    env.SERVER_URL = "${env.SERVER_URL_PRODUCTION}"
                }

                echo "BUILD_ENV: test"
                echo "TAG: $TAG"
            }
        }
        // Build
        stage('Build') {
            when {
                expression {
                    return env.DISABLE_BUILD_STEP != 'true';
                }
            }
            parallel {
                stage('NextJs App') {
                    steps {
                      sh 'chmod +x ./jenkins/scripts/build.sh && ./jenkins/scripts/build.sh'
                    }
                }
            }
        }
        // Push Docker image to Docker Registry
        stage('Push Image To Registry') {
            when {
                expression {
                    return env.DISABLE_BUILD_STEP != 'true';
                }
            }
            steps {
                sh 'chmod +x ./jenkins/scripts/push-ecr.sh && ./jenkins/scripts/push-ecr.sh'
            }
        }
        // Deploy
        stage('Deploy') {
            when {
                anyOf {
                    branch 'master'
                    branch 'test'
                }
            }

            steps {
                sh 'chmod +x ./jenkins/scripts/deploy-ecs.sh && ./jenkins/scripts/deploy-ecs.sh'
            }
        }
        stage('Cleanup') {
            steps {
                // sh 'chmod +x ./jenkins/scripts/cleanup.sh && ./jenkins/scripts/cleanup.sh'
                echo 'skip clean atm'
            }
        }
    }

    post {
        always {
            rocketSend channel: '#DP_Kidokido_Deploy_Notification',
                color: COLOR_MAP[currentBuild.currentResult],
                message: "`Kidokido (${TAG})` - *${currentBuild.currentResult}*\n    Job ${JOB_NAME} build ${BUILD_NUMBER}\n    ${BUILD_URL}\n    Changes: \n$changeString"
        }
    }
}
